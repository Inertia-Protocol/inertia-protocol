  "types": [
    {
      "name": "EscrowState",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "user_wallet",
            "docs": [
              "Original trader. Only this key may call `self_rescue`, and it is the",
              "mandatory destination for swap output (see V6, wrapper contract exploit)."
            ],
            "type": "pubkey"
          },
          {
            "name": "partner_wallet",
            "docs": [
              "Integration partner's treasury. Receives 5% of the buffer when a swap",
              "is executed after the TTL (a genuine keeper rescue)."
            ],
            "type": "pubkey"
          },
          {
            "name": "user_input_token_account",
            "docs": [
              "User's own token account holding the trade input. Never moved out of",
              "user custody directly -- the escrow only ever holds delegated spending",
              "authority over it (SPL Token `approve`), revocable independently of",
              "this program at any time via a plain `revoke` instruction."
            ],
            "type": "pubkey"
          },
          {
            "name": "input_amount",
            "docs": [
              "Amount delegated and expected to be swapped."
            ],
            "type": "u64"
          },
          {
            "name": "expected_program_id",
            "docs": [
              "Program ID the swap CPI must be executed against."
            ],
            "type": "pubkey"
          },
          {
            "name": "expected_discriminator",
            "docs": [
              "Anchor 8-byte instruction discriminator identifying which instruction",
              "on `expected_program_id` to invoke."
            ],
            "type": {
              "array": [
                "u8",
                8
              ]
            }
          },
          {
            "name": "expected_destination_token_account",
            "docs": [
              "The token account that must receive swap output -- the canonical ATA",
              "for (user_wallet, output_mint), computed off-chain and fixed at init."
            ],
            "type": "pubkey"
          },
          {
            "name": "expected_output_amount",
            "docs": [
              "Minimum acceptable output amount (slippage floor). The swap CPI's",
              "result is checked against this before any funds are released."
            ],
            "type": "u64"
          },
          {
            "name": "gas_buffer_lamports",
            "docs": [
              "Lamports held as bounty/refund buffer (separate from the account's",
              "rent-exempt reserve)."
            ],
            "type": "u64"
          },
          {
            "name": "creation_slot",
            "type": "u64"
          },
          {
            "name": "ttl_slots",
            "docs": [
              "Hardcoded to TTL_SLOTS at init; stored for on-chain readability of the",
              "liveness check rather than re-reading the constant."
            ],
            "type": "u64"
          },
          {
            "name": "nonce",
            "docs": [
              "Client-generated value used only to make the PDA unique per (user,",
              "escrow). Not a signature -- see build log for why original_tx_signature",
              "can't be used as a seed or stored as a field."
            ],
            "type": "u64"
          },
          {
            "name": "status",
            "type": {
              "defined": {
                "name": "EscrowStatus"
              }
            }
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "EscrowStatus",
      "type": {
        "kind": "enum",
        "variants": [
          {
            "name": "Pending"
          },
          {
            "name": "Executed"
          },
          {
            "name": "Rescued"
          },
          {
            "name": "Expired"
          }
        ]
      }
    },
    {
      "name": "InitializeEscrowParams",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "nonce",
            "docs": [
              "Client-generated, used only to make the PDA unique per (user_wallet, escrow)."
            ],
            "type": "u64"
          },
          {
            "name": "gas_buffer_lamports",
            "type": "u64"
          },
          {
            "name": "dynamic_minimum_lamports",
            "docs": [
              "Computed off-chain by the SDK from real-time p95 priority fees (Sec. 3,",
              "Dynamic Buffer Sizing). This is a sanity/UX guard, not an adversarial",
              "check: the same party constructing this transaction supplies both this",
              "value and `gas_buffer_lamports`, so it protects against SDK bugs",
              "under-funding the escrow, not against a malicious counterparty."
            ],
            "type": "u64"
          },
          {
            "name": "partner_wallet",
            "type": "pubkey"
          },
          {
            "name": "input_amount",
            "type": "u64"
          },
          {
            "name": "expected_program_id",
            "type": "pubkey"
          },
          {
            "name": "expected_discriminator",
            "type": {
              "array": [
                "u8",
                8
              ]
            }
          },
          {
            "name": "expected_output_amount",
            "type": "u64"
          }
        ]
      }
    },
    {
      "name": "SwapExecuted",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "escrow",
            "type": "pubkey"
          },
          {
            "name": "user_wallet",
            "type": "pubkey"
          },
          {
            "name": "was_rescue",
            "type": "bool"
          },
          {
            "name": "caller",
            "type": "pubkey"
          },
          {
            "name": "output_amount",
            "type": "u64"
          }
        ]
      }
    }
  ]
